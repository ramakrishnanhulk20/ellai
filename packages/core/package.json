    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@t2000/sui-x402": "11.7.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
