# Ellai environment. `npm run setup -w packages/proof` writes the wallet and master secrets;
# generate SESSION_SECRET and JOBS_SECRET as their comments say. Never copy this file
# over an existing .env: that would wipe the master secret, and every purse derived from
# it would be lost.

# Fixed: Ellai runs on Sui Mainnet only. Written by `npm run setup -w packages/proof`.
SUI_NETWORK=mainnet

# Your Tatum key: dashboard.tatum.io, create a MAINNET API key. Optional for the proof scripts (anonymous use is 5 requests a minute).
TATUM_API_KEY=

# Generated by `npm run setup -w packages/proof`. 64 hex characters; every purse and Walrus delegate key derives from it.
ELLAI_MASTER_SECRET=

# Generated by `npm run setup -w packages/proof`. Ed25519 key (suiprivkey...) of the test owner wallet.
OWNER_TEST_PRIVATE_KEY=

# Generated by `npm run setup -w packages/proof`. Ed25519 key (suiprivkey...) of the wallet that pays gas for refills.
GAS_PRIVATE_KEY=

# Walrus Memory hosted relayer, not used yet.
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz

# Your Anthropic API key from console.anthropic.com, for the built-in agent, not used yet. Server only.
ANTHROPIC_API_KEY=

# Your Neon Postgres connection string (neon.tech, free tier), not used yet.
DATABASE_URL=

# 64 hex characters for owner sign-in sessions. Generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Server only.
SESSION_SECRET=

# 64 hex characters that the scheduled jobs present to the server. Generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`. Server only.
JOBS_SECRET=

# The site's https origin, with no path (https://your-site.example). Use http://localhost:3000 in development.
APP_ORIGIN=
