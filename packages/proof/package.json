    "probe:pay": "tsx --env-file-if-exists=../../.env scripts/probe-pay.ts",
    "prove:memory": "tsx --env-file-if-exists=../../.env scripts/prove-memory.ts",
    "prove:pay": "tsx --env-file-if-exists=../../.env scripts/prove-pay.ts",
    "prove:multisig": "tsx --env-file-if-exists=../../.env scripts/prove-multisig.ts",
    "prove:end": "tsx --env-file-if-exists=../../.env scripts/prove-end.ts"
  },
  "dependencies": {
    "@ellai/core": "*",
    "@mysten-incubation/memwal": "0.1.8",
    "@mysten/sui": "2.37.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@t2000/sui-x402": "11.7.0",
