{
  "name": "@ellai/core",
  "private": true,
  "type": "module",
  "exports": {
    "./chain": { "types": "./dist/chain.d.ts", "default": "./dist/chain.js" },
    "./keys": { "types": "./dist/keys.d.ts", "default": "./dist/keys.js" },
    "./net": { "types": "./dist/net.d.ts", "default": "./dist/net.js" },
    "./challenge": { "types": "./dist/challenge.d.ts", "default": "./dist/challenge.js" },
    "./payment": { "types": "./dist/payment.d.ts", "default": "./dist/payment.js" },
    "./allowance": { "types": "./dist/allowance.d.ts", "default": "./dist/allowance.js" },
    "./memory": { "types": "./dist/memory.d.ts", "default": "./dist/memory.js" },
    "./multisig": { "types": "./dist/multisig.d.ts", "default": "./dist/multisig.js" },
    "./usdc": { "types": "./dist/usdc.d.ts", "default": "./dist/usdc.js" },
    "./limits": { "types": "./dist/limits.d.ts", "default": "./dist/limits.js" },
